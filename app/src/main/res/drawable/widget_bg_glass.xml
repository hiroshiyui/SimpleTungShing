<?xml version="1.0" encoding="utf-8"?>
<!-- A glass look: widgets cannot blur what is behind them, so this layers a soft
     diagonal tint, a sheen fading out by the middle, and a light edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/widget_glass_end"
                android:startColor="@color/widget_glass_start"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient
                android:angle="270"
                android:centerColor="@android:color/transparent"
                android:endColor="@android:color/transparent"
                android:startColor="@color/widget_glass_sheen"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_edge" />
        </shape>
    </item>
</layer-list>
